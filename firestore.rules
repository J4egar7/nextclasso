rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone who is a real admin has a document here: admins/{their-auth-uid}.
    // The document's content doesn't matter — only its existence does.
    // Only readable by the user checking their own status; never listable,
    // never writable from the client (manage this collection from the
    // Firebase console, or the Admin SDK, only).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Product catalogue: public storefront needs to read it.
    // Only signed-in admins (present in /admins) may create, edit or delete.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null &&
                      exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
