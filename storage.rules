rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product images: public to view (they're shown on the storefront),
    // only writable by a signed-in admin (checked against Firestore's
    // admins collection, same as firestore.rules).
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
                      firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
      // Note: enabling this rule prompts you once in the Firebase console
      // to grant Storage permission to read Firestore — accept that prompt.
    }
  }
}
